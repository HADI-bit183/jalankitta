# Konfigurasi Kunci API Google Gemini (untuk Triase Foto Kerusakan Jalan)
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-3.5-flash-lite"

# Konfigurasi Supabase Project
SUPABASE_PROJECT_REF="your-project-ref"
SUPABASE_URL="https://your-project-ref.supabase.co"

# Origin tempat situs dihosting (tanpa slash di akhir, tanpa domain *.supabase.co)
ALLOWED_ORIGINS="http://localhost:8080,http://localhost:3000,http://127.0.0.1:8080,http://127.0.0.1:5500,https://jalankitta.web.app"

# Token otentikasi cron pembersihan storage yatim (constant-time token)
CRON_SECRET="your-cron-secret-token"
